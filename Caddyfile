# Aboyeur edge. APP_DOMAIN=localhost -> self-signed cert (local smoke test);
# a real hostname -> Let's Encrypt. Behind Cloudflare use "Full (strict)"
# and an Origin CA cert, or leave Let's Encrypt with DNS-01 — see DEPLOYMENT.md.
# Cloudflare's edge ranges (https://www.cloudflare.com/ips/ — re-check
# yearly). Only a request that arrives FROM one of these gets to say who the
# client is via CF-Connecting-IP; anyone hitting the origin IP directly is
# identified by their own address and has their CF-* headers stripped, so
# they can't spoof a fresh IP per login attempt or pick a pricing country.
# Belt and braces with the Hetzner firewall rule that only opens 443 to
# these ranges (DEPLOYMENT.md §1).
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

{$APP_DOMAIN} {
    encode zstd gzip

    # Not from Cloudflare: drop the edge-only headers the backend trusts
    # when TRUST_CF_HEADERS=true.
    @direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    request_header @direct -CF-IPCountry

    # Every backend route the SPA talks to. The legacy pre-agent routes
    # (/books, /pantry, /menu, /search, ...) and the OpenAI-compat shim
    # (/v1) are deliberately NOT exposed.
    @api path /api/* /auth/* /chat /chat/* /profile/* /health
    handle @api {
        reverse_proxy backend:8000 {
            # {client_ip} is CF-Connecting-IP only when the hop came from a
            # trusted proxy (global `servers` block), else the socket peer.
            header_up CF-Connecting-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            # SSE: don't buffer the chat stream.
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    log {
        output stdout
        format json
    }
}

# Copy to .env on first run:  cp .env.example .env

# Recipe corpus — SMB mount, can be slow/stale. Only `index` and verbatim
# recipe reads touch this; `chat` never does.
RECIPES_DIR=/Volumes/General/Cookbooks/Recipes

# Full-book nutrition reference, a SIBLING of RECIPES_DIR (the indexer only
# scans one level under RECIPES_DIR, so this never looks like a recipe).
REFERENCE_DIR=/Volumes/General/Cookbooks/Reference

# SQLite DB (single file, gitignored). MUST be local disk, not the SMB
# share this project lives on — WAL page reads over SMB measured ~150x
# slower than local (query that's <1ms local runs ~150ms over the mount).
DB_PATH=~/.local/share/aboyeur/aboyeur.db

# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Platform-fallback LLM, used ONLY by the CLI and the unauthenticated
# OpenAI-compat shim's seed household. Leave EMPTY on a hosted deploy: web
# users either bring their own key (Settings) or use a hosted provider from
# the admin console (llm_providers) — there is no env fallback for them.
# Never point this at a private/Tailscale address on a public box.
LLM_BASE_URL=
LLM_MODEL=fast
LLM_API_KEY=

# Encrypts the per-user LLM keys in the `llm_settings` table. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset in dev, a key is derived from JWT_SECRET instead — fine locally, but
# rotating JWT_SECRET then makes every stored LLM key undecryptable.
LLM_SETTINGS_KEY=

# Embedding model for the (lazy, Phase 4+) vector column — not used by
# Phase 1 indexing. Placeholder until semantic search is wired.
EMBEDDING_MODEL=nomic-embed-text

# Session cookie Secure flag. Leave unset (true) for any real deploy — it's
# HTTPS behind Caddy. Set false ONLY for local http://localhost dev: Safari
# refuses Secure cookies over plain http, so login "succeeds" then every call
# 401s.
COOKIE_SECURE=

# aboyeur.auth JWT signing secret. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Encrypts client PII at rest (clients.name/email/phone/notes, profile
# data). Separate from LLM_SETTINGS_KEY so rotating one leaves the other's
# ciphertext readable. Same generator as LLM_SETTINGS_KEY. Required (with
# JWT_SECRET and LLM_SETTINGS_KEY) whenever COOKIE_SECURE is not false —
# the app refuses to boot otherwise.
DATA_KEY=

# Public origin of the SPA — used for links in emails and Stripe return URLs.
APP_BASE_URL=http://localhost:5173

# Stripe — https://dashboard.stripe.com/apikeys. Webhook secret from the
# endpoint you register at /api/billing/webhook (`stripe listen` in dev).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email via Resend (verification, reset, low balance). Unset
# in dev = links are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Aboyeur <no-reply@example.com>

# invite (default): /auth/signup needs a code from the admin console.
# open: anyone can sign up.
SIGNUP_MODE=invite

# Error reporting (backend + SPA). Unset = off. PII is scrubbed before send.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Only behind Cloudflare: trust CF-Connecting-IP (rate limits) and
# CF-IPCountry (pricing). Anywhere else a client could forge them.
TRUST_CF_HEADERS=false

# Docker compose only (see DEPLOYMENT.md).
APP_DOMAIN=localhost
LITESTREAM_B2_BUCKET=
LITESTREAM_B2_PATH=aboyeur
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_B2_ENDPOINT=

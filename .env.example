# Copy to .env on first run:  cp .env.example .env

# Recipe corpus — SMB mount, can be slow/stale. Only `index` and verbatim
# recipe reads touch this; `chat` never does.
RECIPES_DIR=/Volumes/General/Cookbooks/Recipes

# Full-book nutrition reference, a SIBLING of RECIPES_DIR (the indexer only
# scans one level under RECIPES_DIR, so this never looks like a recipe).
REFERENCE_DIR=/Volumes/General/Cookbooks/Reference

# SQLite DB (single file, gitignored). MUST be local disk, not the SMB
# share this project lives on — WAL page reads over SMB measured ~150x
# slower than local (query that's <1ms local runs ~150ms over the mount).
DB_PATH=~/.local/share/aboyeur/aboyeur.db

# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# LiteLLM on DGX Spark (Tailscale). Default works if Tailscale is connected.
LLM_BASE_URL=http://100.70.6.1:4000/v1
LLM_MODEL=fast

# Optional fallback LLM key — used by the CLI and the OpenWebUI shim. Web
# users store their own endpoint/model/key in Settings, which overrides these.
LLM_API_KEY=

# Encrypts the per-user LLM keys in the `llm_settings` table. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset in dev, a key is derived from JWT_SECRET instead — fine locally, but
# rotating JWT_SECRET then makes every stored LLM key undecryptable.
LLM_SETTINGS_KEY=

# Embedding model for the (lazy, Phase 4+) vector column — not used by
# Phase 1 indexing. Placeholder until semantic search is wired.
EMBEDDING_MODEL=nomic-embed-text

# Session cookie Secure flag. Leave unset (true) for any real deploy — it's
# HTTPS behind Caddy. Set false ONLY for local http://localhost dev: Safari
# refuses Secure cookies over plain http, so login "succeeds" then every call
# 401s.
COOKIE_SECURE=

# aboyeur.auth JWT signing secret. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

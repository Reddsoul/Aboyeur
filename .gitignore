.env
# Root-anchored: the stale DB copy at ./data. Unanchored `data/` also
# matched aboyeur/data/ (the Macro Kit component library), silently
# keeping a real source package out of the repo.
/data/
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
backend/__pycache__/
thoughts/
# Server-side copy of the recipe corpus (docker-compose bind mount)
/corpus/
